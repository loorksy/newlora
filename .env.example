# Generate locally with: uv run python scripts/bootstrap.py
# Names only. Do not commit real values.
MASTER_KEY=
JWT_SECRET=
OWNER_PASSWORD_HASH=
BROWSER_TOKEN=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://newlora:CHANGE_ME@postgres:5432/newlora
REDIS_URL=redis://redis:6379/0
BROWSER_URL=http://browser:8090
# Set these when a real Newlora hostname exists. Until then the API stays on localhost.
PUBLIC_URL=https://newlora.example.com
DOMAIN=newlora.example.com
ARTIFACT_DIR=/data/artifacts
CATALOG_MANIFEST=packages/shared/models.json
SEARCH_URL=http://search:8080
# Firebase is not an API key in this file. Mount the service-account JSON read-only
# and then set this path. Leave it unset until that file exists.
# FCM_CREDENTIALS=/run/secrets/firebase-admin.json
MAX_AGENT_STEPS=16
MAX_SUBAGENTS=3
LEASE_SECONDS=120
# OANDA Practice, OpenAI, Anthropic, and Z.AI are not environment variables.
# After login, store them with PUT /settings/credentials/{oanda|openai|anthropic|zai}.
# OANDA also requires {"account":"<practice-account-id>","environment":"practice"}.
